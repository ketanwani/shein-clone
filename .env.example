# Copy to .env.local and fill in. .env.local is gitignored.

# --- Auth (Better Auth) ----------------------------------------------------
# Base URL the app is served from in local dev.
BETTER_AUTH_URL=http://localhost:3000
# Any random 32-byte string: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Every OTP request accepts this fixed code, so agents can sign in with no mail
# provider. Applies in production too — this app is a demo. Anyone who can reach the
# server can therefore sign in as any email address; keep real data out of it.
# Defaults to 000000. Set to "off" for random codes (needs a real mail provider).
DEMO_OTP=000000

# --- Database (Postgres) ---------------------------------------------------
# Required by lib/db/index.ts for Better Auth, wishlist, and orders.
# Local PGlite server (npm run db): postgresql://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL=

# --- Shopify Storefront API ------------------------------------------------
# Required by lib/shopify/client.ts for all product, collection, and search pages.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
